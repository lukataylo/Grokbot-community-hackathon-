# Lumzel. Every service is optional in development: missing ones degrade gracefully.
# In production the app refuses to start without SESSION_SECRET, DATABASE_URL, PUBLIC_URL and the S3 bucket.

# Public base URL (used in QR codes, smart links and emails)
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://localhost:5432/lumzel
SESSION_SECRET=change-me-to-a-long-random-string

# Photo storage (S3-compatible). Unset = local disk at LOCAL_STORE_DIR (.data/store)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "virtual-host" (Railway, R2, AWS) or "path" (MinIO)
S3_URL_STYLE=virtual-host

# Sharing agent and vision double-check (OpenRouter)
OPENROUTER_API_KEY=
VISION_MODEL=openai/gpt-6-luna
TEXT_MODEL=deepseek/deepseek-v4.1-flash

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email via Resend (lumzel.com is verified there). Unset = emails are logged and dev sign-in shows the link
RESEND_API_KEY=
MAIL_FROM=Lumzel <hello@lumzel.com>
# Gets an email for every new beta sign-up
NOTIFY_EMAIL=

# Stripe: £50 per-event sharing unlock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Private beta: who may create events. Comma-separated emails or @domain. Unset: open in dev, closed in production.
BETA_EMAILS=

# Enables /api/test/* hooks for Playwright. Never set in production.
# The e2e tests sign in as e2e+…@lumzel.test, so include @lumzel.test in BETA_EMAILS when running them.
E2E_SECRET=
