# Grok (xAI). Without a key, the app uses the deterministic mock.
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_VISION_MODEL=grok-4

# Public base URL used in the join QR code (e.g. your ngrok/Vercel URL so phones can scan it)
NEXT_PUBLIC_PUBLIC_URL=

# Optional Autopilot integrations. Each one falls back to an export or share link when unset.
# Ghost Admin API: the site URL and an Admin API key ("id:secret") from Settings > Integrations.
GHOST_ADMIN_URL=
GHOST_ADMIN_KEY=
# Discord channel webhook for announcements and last-minute changes.
DISCORD_WEBHOOK_URL=
# Notion internal integration token, plus the id of a page shared with that integration.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
